<resources xmlns:tools="http://schemas.android.com/tools">
  <!-- Base application theme. -->
  <style name="Theme.ArticleApp" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
    <!-- Primary brand color. -->
    <item name="colorPrimary">@color/purple_500</item>
    <item name="colorPrimaryVariant">@color/purple_700</item>
    <item name="colorOnPrimary">@color/white</item>
    <!-- Secondary brand color. -->
    <item name="colorSecondary">@color/teal_200</item>
    <item name="colorSecondaryVariant">@color/teal_700</item>
    <item name="colorOnSecondary">@color/black</item>
    <!-- Status bar color. -->
    <item name="android:statusBarColor" tools:targetApi="l">?attr/colorPrimaryVariant</item>
    <!-- Settings screens (androidx.preference) -->
    <item name="preferenceTheme">@style/PreferenceThemeOverlay</item>
    <!-- Customize your theme here. -->
  </style>

  <!-- Theme for the Settings screen: keeps the action bar with an Up button -->
  <style name="Theme.ArticleApp.Settings" parent="Theme.ArticleApp" />
</resources>
