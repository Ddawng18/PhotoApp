<?xml version="1.0" encoding="utf-8"?>
<!-- The Settings screen: one "Profile" category containing 8 settings. -->
<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto">

  <PreferenceCategory app:title="@string/pref_category_profile">

    <!-- 1. Gender: opens a dialog with radio buttons -->
    <ListPreference
      app:key="gender"
      app:title="@string/pref_title_gender"
      app:entries="@array/pref_gender_titles"
      app:entryValues="@array/pref_gender_values"
      app:defaultValue="@string/pref_default_gender"
      app:useSimpleSummaryProvider="true" />

    <!-- 2. Age: numeric input, default 22 -->
    <EditTextPreference
      app:key="age"
      app:title="@string/pref_title_age"
      app:dialogTitle="@string/pref_dialog_age"
      app:defaultValue="@string/pref_default_age" />

    <!-- 3. Display name -->
    <EditTextPreference
      app:key="display_name"
      app:title="@string/pref_title_display_name"
      app:useSimpleSummaryProvider="true" />

    <!-- 4. Email -->
    <EditTextPreference
      app:key="email"
      app:title="@string/pref_title_email"
      app:useSimpleSummaryProvider="true" />

    <!-- 5. Phone number -->
    <EditTextPreference
      app:key="phone"
      app:title="@string/pref_title_phone"
      app:useSimpleSummaryProvider="true" />

    <!-- 6. Country -->
    <ListPreference
      app:key="country"
      app:title="@string/pref_title_country"
      app:entries="@array/pref_country_titles"
      app:entryValues="@array/pref_country_values"
      app:defaultValue="@string/pref_default_country"
      app:useSimpleSummaryProvider="true" />

    <!-- 7. Notifications on/off (true/false summaries) -->
    <SwitchPreferenceCompat
      app:key="notifications"
      app:title="@string/pref_title_notifications"
      app:defaultValue="true"
      app:summaryOn="@string/pref_summary_notifications_on"
      app:summaryOff="@string/pref_summary_notifications_off" />

    <!-- 8. Email updates: only enabled while Notifications is on -->
    <SwitchPreferenceCompat
      app:key="email_updates"
      app:title="@string/pref_title_email_updates"
      app:dependency="notifications"
      app:defaultValue="false"
      app:summaryOn="@string/pref_summary_email_updates_on"
      app:summaryOff="@string/pref_summary_email_updates_off" />

  </PreferenceCategory>

</PreferenceScreen>
